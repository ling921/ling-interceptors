<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Ling.Interceptors.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ling.Interceptors\Ling.Interceptors.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Ling.Interceptors\Ling.Interceptors.csproj" />
    <ProjectReference Include="..\Ling.Interceptors.CrossAssembly.Target\Ling.Interceptors.CrossAssembly.Target.csproj" />
    <ProjectReference Include="..\..\src\Ling.Interceptors.Console\Ling.Interceptors.Console.csproj" />
  </ItemGroup>

</Project>
