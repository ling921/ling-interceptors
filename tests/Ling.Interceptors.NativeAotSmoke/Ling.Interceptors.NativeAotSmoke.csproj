<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Ling.Interceptors.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ling.Interceptors\Ling.Interceptors.csproj" />
    <ProjectReference Include="..\..\src\Ling.Interceptors.Console\Ling.Interceptors.Console.csproj" />
    <ProjectReference Include="..\..\src\Ling.Interceptors.Logging\Ling.Interceptors.Logging.csproj" />
    <ProjectReference Include="..\..\src\Ling.Interceptors.OpenTelemetry\Ling.Interceptors.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\Ling.Interceptors.Generators\Ling.Interceptors.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed" />
  </ItemGroup>

</Project>
