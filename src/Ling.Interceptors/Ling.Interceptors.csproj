<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Ling.Interceptors</RootNamespace>
    <PackageId>Ling.Interceptors</PackageId>
    <Title>Ling.Interceptors</Title>
    <Authors>Ling</Authors>
    <Description>Compile-time C# method-call interception with Roslyn interceptors, explicit call-site selection, and generated-code support.</Description>
    <PackageTags>interceptors;roslyn;source-generator;analyzer;compile-time;csharp</PackageTags>
    <PackageProjectUrl>https://github.com/ling921/ling-interceptors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ling921/ling-interceptors</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ling.Interceptors.Generators\Ling.Interceptors.Generators.csproj"
                      TreatAsPackageReference="false"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Package Content -->
  <ItemGroup>
    <None Include="..\Ling.Interceptors.Generators\bin\$(Configuration)\netstandard2.0\Ling.Interceptors.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Ling.Interceptors.Generators\bin\$(Configuration)\netstandard2.0\Ling.Interceptors.Generators.pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive\Ling.Interceptors.props" Pack="true" PackagePath="buildTransitive/Ling.Interceptors.props" />
    <None Include="buildTransitive\Ling.Interceptors.targets" Pack="true" PackagePath="buildTransitive/Ling.Interceptors.targets" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="README.zh-CN.md" Pack="true" PackagePath="" />
    <None Include="..\..\assets\icon.png" Visible="false" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
